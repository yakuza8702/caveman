# runtime overrides (copy to .env next to compose, or into container env)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
CAVEMAN_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1   # change endpoint here
CAVEMAN_UPSTREAM_NAME=openrouter
CAVEMAN_MODE=compress

# Model prefix for OpenWebUI — models from this proxy will be shown as "cave-<model>"
# in OpenWebUI, making them distinguishable from direct OpenRouter models.
# Set to empty to disable renaming.
CAVEMAN_MODEL_PREFIX=cave-
